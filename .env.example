# TaxFlow Spain — Environment Variables

# Database (SQLite for local MVP)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — start with: docker compose up -d
# Then change provider in prisma/schema.prisma from sqlite to postgresql
# DATABASE_URL="postgresql://taxflow:taxflow_dev@localhost:5432/taxflow_spain?schema=public"

# Authentication (NextAuth / Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Set to true to skip login during local development without seeding users
AUTH_DISABLED="false"

# OpenAI (server-side only — never expose to frontend)
OPENAI_API_KEY="sk-your-key-here"
OPENAI_MODEL="gpt-4o"

# Application
NEXT_PUBLIC_APP_NAME="TaxFlow Spain"
NEXT_PUBLIC_APP_TAGLINE="AI-assisted Spanish tax workflow automation"

# File storage (local MVP; supabase placeholder for production)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Webhook ingestion (optional — set in production)
WEBHOOK_SECRET="your-webhook-secret-here"

# GDPR / data retention (days)
DATA_RETENTION_DAYS=2555
